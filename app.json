{
  "expo": {
    "name": "RunStride",
    "slug": "runstride",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": ["runstride", "com.tebogolegoabe.runstride"],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tebogolegoabe.runstride"
    },
    "android": {
      "package": "com.tebogolegoabe.runstride",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e0444"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "RunStride uses your photos for your profile and, if you choose, to get verified.",
          "cameraPermission": "RunStride uses the camera to take your selfie and a photo of your ID when you ask to get verified."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#2e0444"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f47c4f"
        }
      ]
    ],
    "backgroundColor": "#2e0444",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d0324a3-4703-41a0-a21f-014c27d9908b"
      }
    },
    "owner": "tebogolegoabe100"
  }
}
