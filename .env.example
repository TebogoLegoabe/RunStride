# Copy to .env. Use your computer's LAN IP when testing on a physical phone
# (find it with `ipconfig`); localhost works for web and emulators.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google sign-in (OAuth client IDs from Google Cloud -> APIs & Services -> Credentials).
# Leave empty to hide the Google button. Phones need a development build; Expo Go can't use it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
