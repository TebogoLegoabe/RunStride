# Copy to backend/.env and fill in. DATABASE_URL is set by docker-compose.
# After editing, apply with: docker compose up -d
ENVIRONMENT=development
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-before-deploying

# Persona ID verification (use sandbox keys in development)
# API key:      Persona dashboard -> API Keys (sandbox key)
# Template ID:  Persona dashboard -> Inquiries -> Templates (starts with itmpl_)
# Webhook secret: Persona dashboard -> Webhooks -> your webhook (starts with wbhsec_)
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# Development only: skip the ID verification step until Persona is set up.
# Remove this line (or set true) once the PERSONA_* values are filled in.
REQUIRE_ID_VERIFICATION=false

# Base URL for run-sharing links sent to trusted contacts. Empty: whatever address the app
# used to reach the API (fine on your own network). To test from another phone on mobile
# data, set this to your tunnel URL (see README). In production: your public HTTPS domain.
PUBLIC_BASE_URL=

# SMS: "console" prints texts to the API logs (development). "bulksms" sends real SMS.
# Create an API token in BulkSMS: Settings -> API Tokens. Real texts cost credits.
SMS_PROVIDER=console
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=

# Photo storage: "local" (development) or "s3" (Cloudflare R2 / AWS S3 / local S3 server).
# Local S3 server for trying it out:  docker compose --profile s3 up -d s3
#   PHOTO_STORAGE=s3
#   S3_ENDPOINT_URL=http://s3:5000
#   S3_REGION=us-east-1
#   S3_BUCKET=runstride-photos
#   S3_ACCESS_KEY_ID=test
#   S3_SECRET_ACCESS_KEY=test
#   S3_PUBLIC_BASE_URL=http://localhost:9000/runstride-photos
# then: docker compose up -d && docker compose exec api python -m app.dev_s3
# Cloudflare R2: see README.
PHOTO_STORAGE=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
