{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Unit tests run straight in Node, which needs the .ts in their imports
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
